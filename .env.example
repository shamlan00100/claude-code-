# Copy to .env.local for local development. Never commit real values.

# Postgres connection string. On Railway, reference the database service:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres@localhost:5432/focuspt"

# Public URL of the app. On Railway this can be left unset: it falls back to
# RAILWAY_PUBLIC_DOMAIN, which is correct for PR environments too.
BETTER_AUTH_URL=http://localhost:3000

# Long random string. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Development and PR preview environments only. Leave unset in production.
ENABLE_QUICK_SIGNIN=true
ALLOW_SEED=true
